# Descargas crudas: se regeneran con los scripts (~770 MB).
# Regla del proyecto: data/raw/ nunca se edita a mano, así que tampoco se versiona.
data/raw/

# Derivados pesados
data/processed/jrc/*.tif
data/processed/georreferenciado/*.tif

# Recortes de trabajo del inspector de láminas: se regeneran con
# `18_vectorizar_laminas.py --inspeccionar` y sólo sirven para que una persona
# lea los rótulos UTM una vez.
data/processed/laminas/_inspeccion/

# Censo 2024: 73 MB que se regeneran con `scripts/16_censo_2024.py`. El script
# valida los totales contra el servicio y se cae si cambiaron, así que el archivo
# no aporta nada en el historial.
data/processed/censo/

# Derivados del modelo regional del GORE: ~18 MB que se regeneran con
# `scripts/15_gore_amenaza.py`. Lo que el visor consume es la versión recortada
# de `web/data/gore/`, que sí se versiona.
data/processed/gore/

# Caché de la capa B: ~830 MB de σ⁰ por fecha y del DEM. Se regenera con
# `scripts/14_sar_huella_observada.py`; lo que el visor consume son los GeoJSON
# de `web/data/sar/`, que sí se versionan.
data/processed/sar/

# Capturas de la auditoría en navegador: son evidencia de una corrida, no fuente.
data/processed/auditoria/

# Los GeoJSON que el frontend consume en runtime SÍ se versionan: si no están
# en el repo, el sitio publicado se ve vacío sin dar ningún error.
# (lección heredada del deploy de valles-volcanicos-chile)
!web/data/**

__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.DS_Store

# Los .docx se generan desde los .md con pandoc: versionar el binario ensucia
# el historial en cada edición de texto. Se comparten directamente, no por git.
docs/*.docx
